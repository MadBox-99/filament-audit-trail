{
    "name": "madbox-99/filament-audit-trail",
    "description": "Append-only audit trail for Laravel with a Filament v5 plugin: logins, page views, actions and data changes, with evidence-based reconstruction of the past.",
    "type": "library",
    "keywords": ["laravel", "filament", "filament-plugin", "audit", "audit-trail", "audit-log"],
    "license": "MIT",
    "authors": [
        {
            "name": "Zoltán Tamás Szabó",
            "email": "zoli.szabok@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.0",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Madbox99\\FilamentAuditTrail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Madbox99\\FilamentAuditTrail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Madbox99\\FilamentAuditTrail\\FilamentAuditTrailServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
